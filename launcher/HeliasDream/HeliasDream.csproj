<Project Sdk="Microsoft.NET.Sdk">
  <!-- Helia's Dream: the launcher. Windows and Linux from one Avalonia app. It writes the
       settings the engine reads (~/.config/HeliasDream) and starts the game; the game itself, its F10
       menu and the in-game trophy pop-ups stay in the engine. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HeliasDream</AssemblyName>
    <RootNamespace>HeliasDream</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.0" />
    <!-- Avalonia 11.3.0 brings 0.21.2, which has a high-severity advisory (GHSA-xrw6-gwf8-vvr9); 0.21.3 is its fix. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
