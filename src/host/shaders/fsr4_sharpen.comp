#version 450
// heliasdream-vk test7: the sharpening of FSR 4.1.1's output (host/fsr4_pass.cpp), in
// place of the replay's own RCAS pass (HELIAS_FSR4_SHARPEN=amd keeps that one).
// AMD's RCAS math (fsr1/ffx_fsr1.h, MIT, included unchanged) with its noise
// removal on, fed from a 18x18 tile in shared memory: one 16x16 block of
// output per group of 64 threads, each image texel read once per block instead
// of five times.
// test7b: what the postpass leaves for RCAS is not the colour. It is
// log-encoded and exposed, v = log2(1 + 150 c') / 12.2887 (c' = c * exposure
// / pre-exposure, 0..1 for c' up to 33.3), the domain RCAS runs in. The
// result is decoded as the replay's rcas.spv does - c = (2^(12.2887 v) - 1)
// / 150, divided by exposure / pre-exposure - and its alpha is its red, as
// there. test7 wrote the encoded values out as colour: a white haze.
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Constants {
    uvec4 con0;          // FsrRcasCon: con0.x = the sharpness as a float's bits
    uvec2 size;          // the image's width and height
    float pre_exposure;  // as the replay's cbRCAS
};

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D src_image;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst_image;
// The replay's auto-exposure texture (r_auto_exposure_texture): texel (0, 0).
layout(set = 0, binding = 2, r32f) uniform readonly image2D exposure_image;

shared vec4 tile[18][18];
ivec2 g_origin;  // the block's first texel minus one (the tile's [0][0])

#define A_GPU 1
#define A_GLSL 1
#include "fsr1/ffx_a.h"

#define FSR_RCAS_F 1
#define FSR_RCAS_DENOISE 1
AF4 FsrRcasLoadF(ASU2 p) {
    const ivec2 t = clamp(ivec2(p) - g_origin, ivec2(0), ivec2(17));
    return tile[t.y][t.x];
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "fsr1/ffx_fsr1.h"

// The postpass's encoding undone (rcas.spv's constants).
vec3 decode(vec3 v, float inv_exposure) { return max((exp2(12.2887039 * v) - 1.0) * (1.0 / 150.0), vec3(0.0)) * inv_exposure; }

void main() {
    const ivec2 block = ivec2(gl_WorkGroupID.xy) * 16;
    g_origin = block - 1;
    const ivec2 last = ivec2(size) - 1;
    for (uint i = gl_LocalInvocationIndex; i < 18u * 18u; i += 64u) {
        const ivec2 t = ivec2(int(i % 18u), int(i / 18u));
        const vec4 c = imageLoad(src_image, clamp(g_origin + t, ivec2(0), last));
        tile[t.y][t.x] = c;
    }
    barrier();
    const float inv_exposure = pre_exposure / imageLoad(exposure_image, ivec2(0)).r;
    for (uint k = 0u; k < 4u; ++k) {
        const ivec2 local = ivec2(gl_LocalInvocationID.xy) * 2 + ivec2(int(k & 1u), int(k >> 1));
        const ivec2 pos = block + local;
        if (pos.x > last.x || pos.y > last.y) continue;
        AF3 c;
        FsrRcasF(c.r, c.g, c.b, AU2(pos), con0);
        const vec3 o = decode(c, inv_exposure);
        imageStore(dst_image, pos, vec4(o, o.r));
    }
}
