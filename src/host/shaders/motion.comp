#version 460
// heliasdream-vk Phase 2: the scene's motion vectors (host/temporal_inputs.cpp),
// one invocation per render pixel. Camera motion from the scene depth and
// the camera of this frame and the last (host/temporal/camera.h is the same
// math in double, and tests/temporal_test.cpp checks it); where the game's
// own object-velocity target covers the pixel, the object's motion instead.
//
// The view-space reprojection - D3D depth = zs + zo / z, the cleared depth a
// direction rotated without translation, the previous view times the
// inverse current view built in double on the CPU - and the velocity
// target's decoding follow IFreemz's bb_dlss_motion.comp
// (shadPS4-Bloodborne-DLSS-FSR, GPL-2.0-or-later; portions Copyright 2026
// IFreemz).
//
// Out: the depth copy (R32F, binding 4) and RGBA16F, rg = current-to-previous motion in render pixels (+y down),
// b = 1 where the motion is an object's (0.35: the velocity target covers it, the camera's kept), a = 1 where the camera's was valid.
// Compiled offline (tools/build_shaders.sh) into motion.spv.h.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D scene_depth;
layout(set = 0, binding = 1) uniform sampler point_sampler;
layout(set = 0, binding = 2) uniform texture2D velocity;  // the game's 160x90 RGBA8 target, or a dummy
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D motion;
// Phase 3: the scene depth as a colour image (R32F), what the upscalers
// sample (FSR-Vulkan imports colour images only).
layout(set = 0, binding = 4, r32f) uniform writeonly image2D depth_copy;

layout(push_constant) uniform Params {
    vec4 reproject[3];  // previous view x inverse current view, 3x4 rows
    vec4 proj;          // current: x scale, y scale, z scale, z offset
    vec4 prev_proj;
    vec2 jitter;        // this frame's viewport shift of the scene draws, render pixels, +y down
    vec2 velocity_scale;  // the velocity draws' packing scale (their constant buffer)
    uvec2 extent;       // the render size (the depth may be larger: padding)
    uint flags;         // 1 camera usable, 2 velocity usable
    float object_min;   // test5: object motion only where it differs from the camera's by this (render pixels)
} pc;

bool finite2(vec2 v) { return !any(isnan(v)) && !any(isinf(v)); }

void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.extent.x) || xy.y >= int(pc.extent.y)) return;
    const vec2 size = vec2(pc.extent);
    // The surface this jittered pixel shows lies at its unjittered position.
    const vec2 uv = (vec2(xy) + 0.5 - pc.jitter) / size;
    vec2 delta = vec2(0.0);
    float camera_ok = 0.0;
    const float d = texelFetch(sampler2D(scene_depth, point_sampler), xy, 0).r;
    imageStore(depth_copy, xy, vec4(d));
    if ((pc.flags & 1u) != 0u) {
        const bool sky = d >= 1.0;
        const float z = sky ? 1.0 : pc.proj.w / min(d - pc.proj.z, -1e-8);
        const vec2 ndc = vec2(2.0 * uv.x - 1.0, 1.0 - 2.0 * uv.y);
        const vec4 view = vec4(ndc.x * z / pc.proj.x, ndc.y * z / pc.proj.y, z, sky ? 0.0 : 1.0);
        const vec3 pv = vec3(dot(pc.reproject[0], view), dot(pc.reproject[1], view), dot(pc.reproject[2], view));
        const vec2 pndc = vec2(pv.x * pc.prev_proj.x, pv.y * pc.prev_proj.y) / max(pv.z, 1e-4);
        const vec2 puv = vec2(pndc.x * 0.5 + 0.5, 0.5 - pndc.y * 0.5);
        delta = (puv - uv) * size;
        camera_ok = 1.0;
    }
    float object = 0.0;
    if ((pc.flags & 2u) != 0u) {
        // test5 (test4's shimmer on characters): the game's target is 160x90 RGBA8 - a
        // texel covers 16x16 render pixels at 1440p and a step of its 8 bits is ~1.1
        // pixels. So (1) only texels whose 2x2 neighbourhood is all object are taken:
        // at an object's edge the camera's motion stays and FSR's own depth dilation
        // carries the object's onto it; (2) only where the decoded motion differs from
        // the camera's by more than object_min - a still object's quantised velocity
        // (128/255 is not 0.5) is not put over the exact camera motion.
        const ivec2 vsize = textureSize(sampler2D(velocity, point_sampler), 0);
        const vec2 vp = uv * vec2(vsize) - 0.5;
        const ivec2 v0 = clamp(ivec2(floor(vp)), ivec2(0), vsize - 1);
        const ivec2 v1 = clamp(v0 + 1, ivec2(0), vsize - 1);
        const float inside = min(min(texelFetch(sampler2D(velocity, point_sampler), v0, 0).a,
                                     texelFetch(sampler2D(velocity, point_sampler), ivec2(v1.x, v0.y), 0).a),
                                 min(texelFetch(sampler2D(velocity, point_sampler), ivec2(v0.x, v1.y), 0).a,
                                     texelFetch(sampler2D(velocity, point_sampler), v1, 0).a));
        const ivec2 vxy = clamp(ivec2(uv * vec2(vsize)), ivec2(0), vsize - 1);
        const vec4 m = texelFetch(sampler2D(velocity, point_sampler), vxy, 0);
        const vec2 s = pc.velocity_scale;
        if (m.a > 0.5 && abs(s.x) > 1e-6 && abs(s.y) > 1e-6 && finite2(s)) {
            const vec2 od = (m.rg - 0.5) * vec2(-size.x / s.x, size.y / s.y);
            if (inside > 0.5 && (camera_ok < 0.5 || length(od - delta) > pc.object_min)) {
                delta = od;
                object = 1.0;
            } else {
                object = 0.35;  // covered by the target, the camera's motion kept (the motion-vector view's dim blue)
            }
        }
    }
    if (!finite2(delta) || any(greaterThan(abs(delta), size))) {
        delta = vec2(0.0);
        camera_ok = 0.0;
        object = 0.0;
    }
    imageStore(motion, xy, vec4(delta, object, camera_ok));
}
