// The Windows exe's icon and version details. Explorer shows the first icon;
// SDL gives its windows (the setup window and the game's) the same one.
#include "heliasdream_version.h"

1 ICON "heliasdream.ico"

// VS_VERSION_INFO, VOS_NT_WINDOWS32 and VFT_APP from winver.h.
1 VERSIONINFO
FILEVERSION HELIAS_VERSION_NUMBERS,0
PRODUCTVERSION HELIAS_VERSION_NUMBERS,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Helia's Dream engine"
            VALUE "ProductName", "Helia's Dream"
            VALUE "FileVersion", HELIAS_VERSION
            VALUE "ProductVersion", HELIAS_VERSION
            VALUE "InternalName", "heliasdream"
            VALUE "OriginalFilename", "HeliasDream-engine.exe"
            VALUE "LegalCopyright", "GNU General Public License, version 3 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
