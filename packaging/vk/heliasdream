#!/bin/bash
# heliasdream-vk wrapper: native Wayland, sized for the monitor it opens on.
# On a monitor with display scaling (e.g. 150%), SDL draws in real pixels so the
# setup UI fills its window; on a 100% monitor it runs normally.
export SDL_VIDEO_DRIVER=wayland
out=$(qdbus6 org.kde.KWin /KWin activeOutputName 2>/dev/null)
scale=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk -v o="$out" '
  $1=="Output:" {cur=$3} cur==o && $1=="Scale:" {print $2; exit}')
if [ -n "$scale" ] && [ "$scale" != "1" ]; then
  export SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
fi
cd "$(dirname "$(readlink -f "$0")")" || exit 1
exec ./heliasdream.bin "$@"
